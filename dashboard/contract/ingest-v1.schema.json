{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ArtifactIn": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ArtifactKind"
        },
        "md5_b64": {
          "description": "Base64 MD5 of the file contents (what GCS reports as md5Hash).",
          "pattern": "^[A-Za-z0-9+/]{22}==$",
          "type": "string"
        },
        "path": {
          "$ref": "#/definitions/RelativePath"
        },
        "size_bytes": {
          "maximum": 5368709120,
          "minimum": 0,
          "type": "integer"
        },
        "task_name": {
          "description": "Task spec for predictions/requests files, else null.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "size_bytes",
        "md5_b64",
        "content_type",
        "kind"
      ],
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "metrics",
        "manifest",
        "predictions",
        "requests",
        "inference_metrics",
        "logs",
        "traces",
        "other"
      ],
      "type": "string"
    },
    "BeakerInfo": {
      "additionalProperties": false,
      "description": "Beaker metadata captured from the job environment. All null outside Beaker.",
      "properties": {
        "budget": {
          "type": [
            "string",
            "null"
          ]
        },
        "cluster": {
          "description": "Cluster, e.g. \"ai2/jupiter\". From OLMO_EVAL_BEAKER_CLUSTER or derived from node_hostname.",
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_count": {
          "type": [
            "number",
            "null"
          ]
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_count": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "description": "Beaker image or Docker image the job ran.",
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "node_hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_dataset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workload_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "description": "Workspace full name, e.g. \"ai2/olmo-eval-debug\".",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "experiment_id",
        "workload_id",
        "job_id",
        "task_id",
        "workspace",
        "workspace_id",
        "result_dataset_id",
        "node_hostname",
        "cluster",
        "priority",
        "image",
        "budget",
        "gpu_count",
        "cpu_count"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Always \"olmo-eval\" for the official client.",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "CompleteRequest": {
      "additionalProperties": false,
      "description": "Finish an upload. The server recomputes derived data (stderr, metric kinds, suite stderr, score vectors, run summary), verifies artifacts, and marks the upload complete. Idempotent.",
      "properties": {
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected_artifacts": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "expected_task_results": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/DateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/FinalRunStatus"
        },
        "suites": {
          "items": {
            "$ref": "#/definitions/SuiteResultIn"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "finished_at",
        "duration_seconds",
        "suites",
        "expected_task_results",
        "expected_artifacts"
      ],
      "type": "object"
    },
    "CompleteResponse": {
      "additionalProperties": false,
      "properties": {
        "artifacts_missing": {
          "description": "Artifact paths that were signed but are missing from GCS.",
          "items": {
            "$ref": "#/definitions/RelativePath"
          },
          "type": "array"
        },
        "dashboard_url": {
          "type": "string"
        },
        "instances": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "run_id": {
          "$ref": "#/definitions/RunId"
        },
        "status": {
          "$ref": "#/definitions/FinalRunStatus"
        },
        "task_results": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "upload_state": {
          "$ref": "#/definitions/UploadState"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "status",
        "upload_state",
        "dashboard_url",
        "task_results",
        "instances",
        "artifacts_missing",
        "warnings"
      ],
      "type": "object"
    },
    "DateTime": {
      "format": "date-time",
      "type": "string"
    },
    "EnvironmentInfo": {
      "additionalProperties": false,
      "properties": {
        "cuda_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_count": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_type": {
          "description": "e.g. \"NVIDIA H100 80GB HBM3\".",
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "packages": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Installed distribution versions: \"olmo-eval\", \"vllm\", \"torch\", \"transformers\", \"datasets\", \"litellm\" when present.",
          "type": "object"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "python_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hostname",
        "platform",
        "python_version",
        "packages",
        "cuda_version",
        "gpu_type",
        "gpu_count"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Machine-readable code: bad_request, unauthenticated, forbidden, not_found, conflict, payload_too_large, validation_error, internal.",
          "type": "string"
        },
        "details": {},
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "Body of every non-2xx response.",
      "properties": {
        "error": {
          "$ref": "#/definitions/ErrorBody"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "FinalRunStatus": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "type": "string"
    },
    "FlatMetrics": {
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      },
      "description": "Flat metrics keyed by \"metric_name:scorer_name\".",
      "type": "object"
    },
    "GitInfo": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "description": "Full SHA when known (GIT_REF in Beaker), else a short SHA.",
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "True when the local working tree had uncommitted changes.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "repo": {
          "description": "\"owner/name\", e.g. \"allenai/olmo-eval\" (GITHUB_REPO in Beaker).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repo",
        "commit",
        "branch",
        "dirty"
      ],
      "type": "object"
    },
    "GpuDeviceIn": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "memory_total_mb": {
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "name",
        "memory_total_mb"
      ],
      "type": "object"
    },
    "InferenceBatchIn": {
      "additionalProperties": false,
      "description": "One BatchMetrics line from metrics/*-inference.jsonl without gpu_devices or requests.",
      "properties": {
        "failed_requests": {
          "$ref": "#/definitions/NonNegativeInt32"
        },
        "gpu_summary": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "BatchMetrics gpu_summary as written."
        },
        "mean_latency_s": {
          "type": "number"
        },
        "output_tokens_per_second": {
          "type": "number"
        },
        "seq": {
          "$ref": "#/definitions/NonNegativeInt32",
          "description": "Order within the run, starting at 0."
        },
        "successful_requests": {
          "$ref": "#/definitions/NonNegativeInt32"
        },
        "task_name": {
          "description": "BatchMetrics.task_name (null today: chunks mix tasks).",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "$ref": "#/definitions/DateTime"
        },
        "total_completion_tokens": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "total_prompt_tokens": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "total_requests": {
          "$ref": "#/definitions/NonNegativeInt32"
        },
        "wall_clock_time_s": {
          "type": "number"
        }
      },
      "required": [
        "seq",
        "timestamp",
        "task_name",
        "total_requests",
        "successful_requests",
        "failed_requests",
        "total_prompt_tokens",
        "total_completion_tokens",
        "wall_clock_time_s",
        "output_tokens_per_second",
        "mean_latency_s",
        "gpu_summary"
      ],
      "type": "object"
    },
    "InferenceUploadRequest": {
      "additionalProperties": false,
      "description": "Replaces all inference data for the run.",
      "properties": {
        "batches": {
          "items": {
            "$ref": "#/definitions/InferenceBatchIn"
          },
          "maxItems": 20000,
          "type": "array"
        },
        "gpu_devices": {
          "items": {
            "$ref": "#/definitions/GpuDeviceIn"
          },
          "type": "array"
        },
        "request_latency": {
          "anyOf": [
            {
              "$ref": "#/definitions/RequestLatencyIn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present only when per-request metrics were recorded."
        },
        "series": {
          "items": {
            "$ref": "#/definitions/SeriesIn"
          },
          "maxItems": 64,
          "type": "array"
        },
        "source_paths": {
          "description": "Relative paths of the source JSONL files.",
          "items": {
            "$ref": "#/definitions/RelativePath"
          },
          "type": "array"
        }
      },
      "required": [
        "source_paths",
        "batches",
        "series",
        "request_latency",
        "gpu_devices"
      ],
      "type": "object"
    },
    "InferenceUploadResponse": {
      "additionalProperties": false,
      "properties": {
        "batches_stored": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "series_stored": {
          "$ref": "#/definitions/NonNegativeInteger"
        }
      },
      "required": [
        "batches_stored",
        "series_stored"
      ],
      "type": "object"
    },
    "InstanceBatchRequest": {
      "additionalProperties": false,
      "properties": {
        "batch_index": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "instances": {
          "items": {
            "$ref": "#/definitions/InstanceIn"
          },
          "maxItems": 2000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "batch_index",
        "instances"
      ],
      "type": "object"
    },
    "InstanceBatchResponse": {
      "additionalProperties": false,
      "properties": {
        "received": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "task_result_id": {
          "$ref": "#/definitions/Integer"
        },
        "total_stored": {
          "$ref": "#/definitions/NonNegativeInteger",
          "description": "Instances stored for this task result after this batch."
        }
      },
      "required": [
        "task_result_id",
        "received",
        "total_stored"
      ],
      "type": "object"
    },
    "InstanceIn": {
      "additionalProperties": false,
      "description": "Compact per-instance row extracted by olmo-eval from the predictions and requests JSONL files. Full records stay in GCS and are read by byte range.",
      "properties": {
        "completion_tokens": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInt32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sum over all generated samples (multiple choice: model_output[0])."
        },
        "doc_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInt32"
            },
            {
              "type": "null"
            }
          ]
        },
        "extracted_answer": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "finish_reason": {
          "description": "\"length\" if any sample was truncated, else model_output[0].finish_reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "has_execution_result": {
          "type": "boolean"
        },
        "has_judge_result": {
          "type": "boolean"
        },
        "has_scoring_error": {
          "type": "boolean"
        },
        "has_trajectory": {
          "type": "boolean"
        },
        "judge_verdict": {
          "description": "judge_result when it is a string, else judge_result.verdict, truncated.",
          "maxLength": 64,
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Gold label, JSON-encoded when not a string, truncated.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "metrics": {
          "$ref": "#/definitions/FlatMetrics",
          "description": "All finite per-instance metric values, flattened to \"metric:scorer\".",
          "maxProperties": 200
        },
        "native_id": {
          "description": "str(native_id), truncated to 512 characters. Unique within a task result; duplicates get a \"#<n>\" suffix, added within the 512-character limit.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "num_outputs": {
          "$ref": "#/definitions/NonNegativeInteger",
          "description": "len(model_output)."
        },
        "output_preview": {
          "description": "First 300 characters of model_output[0].text (or final_output).",
          "maxLength": 300,
          "type": [
            "string",
            "null"
          ]
        },
        "pred_length": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInt32"
            },
            {
              "type": "null"
            }
          ]
        },
        "pred_offset": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ],
          "description": "Byte offset and length (without the newline) of this instance's line in predictions_path."
        },
        "primary_score": {
          "description": "Value of the task's primary metric for this instance, null when absent.",
          "type": [
            "number",
            "null"
          ]
        },
        "prompt_preview": {
          "description": "First 300 characters of the question: request doc.query, else the last user message, else the end of the prompt string.",
          "maxLength": 300,
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInt32"
            },
            {
              "type": "null"
            }
          ],
          "description": "Prompt tokens for this instance (log-likelihood requests: context plus continuation)."
        },
        "req_length": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInt32"
            },
            {
              "type": "null"
            }
          ]
        },
        "req_offset": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ],
          "description": "Byte offset and length of the matching line in requests_path, null when not found."
        }
      },
      "required": [
        "native_id",
        "doc_id",
        "primary_score",
        "metrics",
        "label",
        "finish_reason",
        "completion_tokens",
        "prompt_tokens",
        "num_outputs",
        "extracted_answer",
        "prompt_preview",
        "output_preview",
        "judge_verdict",
        "has_scoring_error",
        "has_execution_result",
        "has_judge_result",
        "has_trajectory",
        "pred_offset",
        "pred_length",
        "req_offset",
        "req_length"
      ],
      "type": "object"
    },
    "Integer": {
      "type": "integer"
    },
    "JsonObject": {
      "additionalProperties": {},
      "description": "Arbitrary JSON object (configs, error summaries).",
      "type": "object"
    },
    "LatencyQuantiles": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "description": "Arithmetic mean. Optional because older clients sent quantiles only.",
          "type": "number"
        },
        "n": {
          "$ref": "#/definitions/NonNegativeInteger"
        },
        "p25": {
          "type": "number"
        },
        "p5": {
          "type": "number"
        },
        "p50": {
          "type": "number"
        },
        "p75": {
          "type": "number"
        },
        "p95": {
          "type": "number"
        }
      },
      "required": [
        "p5",
        "p25",
        "p50",
        "p75",
        "p95",
        "n"
      ],
      "type": "object"
    },
    "MetricMetaIn": {
      "additionalProperties": false,
      "description": "Per-metric metadata resolved by olmo-eval from live Metric objects. Keyed by metric name (no scorer).",
      "properties": {
        "display_format": {
          "description": "Metric.display_format().",
          "enum": [
            "percent",
            "raw",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "higher_is_better": {
          "description": "Metric.higher_is_better(), null when unknown.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "unit": {
          "description": "Metric.metric_unit().",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "higher_is_better",
        "display_format",
        "unit"
      ],
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "description": "Optional explicit values. The server derives them from name/path/revision when absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "model_hash": {
          "description": "olmo-eval compute_model_hash (16 hex).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Display name: provider alias if set, else provider model.",
          "type": "string"
        },
        "path": {
          "description": "provider.model: HF ID, local path, s3://, gs:// or /weka path.",
          "type": "string"
        },
        "provider_config": {
          "$ref": "#/definitions/JsonObject",
          "description": "ProviderConfig.to_dict() plus attention_backend."
        },
        "provider_kind": {
          "description": "vllm, vllm_server, hf, olmo_core, olmo_core_vlm, litellm, mock, external, ...",
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "series": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_seen": {
          "anyOf": [
            {
              "$ref": "#/definitions/NonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "path",
        "model_hash",
        "revision",
        "provider_kind",
        "provider_config"
      ],
      "type": "object"
    },
    "NestedMetrics": {
      "additionalProperties": {
        "additionalProperties": {
          "type": [
            "number",
            "null"
          ]
        },
        "type": "object"
      },
      "description": "Nested metrics exactly as metrics.json stores them: {metric_name: {scorer_name: value}}.",
      "type": "object"
    },
    "NonNegativeInt32": {
      "description": "A count or size stored in a 32-bit column.",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "NonNegativeInteger": {
      "maximum": 9223372036854776000,
      "minimum": 0,
      "type": "integer"
    },
    "RelativePath": {
      "description": "Path of a file relative to the run's output directory, POSIX separators, no leading slash, no \".\" or \"..\" segments.",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\x00]{1,1024}$",
      "type": "string"
    },
